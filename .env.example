# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Solo para el proxy de correo. Nunca debe llevar el prefijo VITE_ ni llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de correo del proxy: resend (recomendado para desarrollo) o sendgrid
MAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
# En Resend, el remitente debe pertenecer a un dominio verificado.
# Para desarrollo sin dominio verificado usa onboarding@resend.dev y envía
# únicamente al correo del propietario de la cuenta Resend.
MAIL_FROM=notificaciones@alianzacapital.co
MAIL_REPLY_TO=info@alianzacapital.co

# Buzón de operaciones que recibe el OTP de las novedades de saldo
NOVEDAD_OTP_EMAIL=novedaddesaldo@alianzacapital.co
# Copias opcionales del OTP, separadas por coma
NOVEDAD_OTP_CC=

# SendGrid (client-side Vite - usado por src/utils/sendgrid-old.js)
VITE_SENDGRID_API_KEY=

# Email configuration
VITE_FROM_EMAIL=
VITE_ADMIN_EMAIL=
